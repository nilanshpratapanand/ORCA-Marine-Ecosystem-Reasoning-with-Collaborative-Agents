# Copy this file to .env  ->  copy .env.example .env   (bash: cp .env.example .env)
# Fill in ONE key to turn on generated prose + regional-language translation.
# Add more keys and they become automatic fallbacks (tried in the order below).
# With NO keys the app still runs: templated answers + offline phrase translation.
#
# Model names change often. If LLM_DEBUG shows a provider 404ing on its model,
# set the matching *_MODEL below to a current one (each provider lists them at
# its /models endpoint). Defaults verified working Sep 2026.

# --- primary: Groq (Qwen), free + very fast --------------------------------
# get a key: https://console.groq.com/keys
GROQ_API_KEY=
# GROQ_MODEL=qwen/qwen3.8-27b

# --- fallbacks -----------------------------------------------------------
# Cerebras — https://cloud.cerebras.ai/  (free tier may need billing enabled)
CEREBRAS_API_KEY=
# CEREBRAS_MODEL=gpt-oss-120b

# OpenRouter — https://openrouter.ai/keys  (many ":free" models)
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=qwen/qwen3-32b:free

# Google AI Studio (Gemini) — https://aistudio.google.com/apikey
# the key looks like AIza... ; if yours starts with AQ. you copied the wrong thing
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-lite-latest

# Mistral — https://console.mistral.ai/api-keys/
MISTRAL_API_KEY=
# MISTRAL_MODEL=mistral-small-latest

# Together AI — https://api.together.ai/settings/api-keys
TOGETHER_API_KEY=
# TOGETHER_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo-Free

# Anthropic (Claude) — paid; kept last in the cascade
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-3-5-haiku-latest

# --- optional tuning ------------------------------------------------------
# LLM_PROVIDER_ORDER=groq,gemini,mistral   # restrict / reorder the cascade
# LLM_DEBUG=1                              # log which provider answered
# LLM_TIMEOUT=20
